{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veglass",
  "version": "0.1.3",
  "identifier": "app.veglass.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Veglass",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Montage vidéo rapide",
    "longDescription": "Veglass — montage vidéo hybride : bibliothèque, preview synchronisée et timeline multi-pistes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Xeiners/veglass/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxMUFERTI0NDBCOENBQjAKUldTd3lyaEFKTjRhTWZpMXZtMXVQV1h5NlpRdkZVcXFEK1lCWFg5dVc5ck5UVjdSTnpxSDFjS0oK"
    }
  }
}
